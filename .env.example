# EducaFlow - Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores antes de executar o setup.ps1

DATABASE_URL=sqlite:///./data/educaflow.db
SECRET_KEY=sua-chave-secreta-aqui-minimo-32-caracteres
